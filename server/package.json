{
  "name": "ilumine-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "seed": "tsx --env-file=.env src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^10.1.4",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
